{
  "name": "geo-query-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "config:print": "node scripts/build-config.mjs --print",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "cesium": "^1.145.0",
    "monaco-editor": "^0.56.0",
    "ol": "^10.3.1",
    "proj4": "^2.15.0",
    "react": "^18.3.1",
    "react-dom": "^19.3.0",
    "vite-plugin-cesium": "^1.2.23"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@eslint/compat": "^2.1.1",
    "@map-colonies/commitlint-config": "^2.0.1",
    "@map-colonies/eslint-config": "^9.0.0",
    "@map-colonies/eslint-plugin": "^1.0.0",
    "@map-colonies/prettier-config": "^1.0.0",
    "@types/proj4": "^2.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
