# Normalize to LF in the repo and in the working tree. Without this, a clone on
# Windows with core.autocrlf=true checks scripts out with CRLF, and a CRLF
# shebang makes the kernel look for an interpreter named "/bin/sh\r" — the
# container entrypoint then fails with a "not found" that names the script.
* text=auto eol=lf

# Files that run inside the image, called out explicitly so this survives
# someone narrowing the glob above.
*.sh text eol=lf
*.mjs text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
